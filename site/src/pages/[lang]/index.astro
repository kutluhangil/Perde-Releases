---
import Base from '../../layouts/Base.astro';
import Curtain from '../../components/Curtain.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Tour from '../../components/Tour.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Uses from '../../components/Uses.astro';
import Features from '../../components/Features.astro';
import Platforms from '../../components/Platforms.astro';
import Compare from '../../components/Compare.astro';
import Privacy from '../../components/Privacy.astro';
import Faq from '../../components/Faq.astro';
import Closing from '../../components/Closing.astro';
import { languages, type Lang } from '../../i18n';
import { latestRelease } from '../../data/release';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const release = await latestRelease();
---

<Base lang={lang}>
  <Curtain />
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} release={release} />
    <Tour lang={lang} />
    <HowItWorks lang={lang} />
    <Uses lang={lang} />
    <Features lang={lang} />
    <Platforms lang={lang} release={release} />
    <Compare lang={lang} />
    <Privacy lang={lang} />
    <Faq lang={lang} />
  </main>
  <Closing lang={lang} />
</Base>

<script>
  import '../../scripts/shell';
  import '../../scripts/motion';
</script>
