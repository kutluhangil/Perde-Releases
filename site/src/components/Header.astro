---
import { Image } from 'astro:assets';
import appIcon from '../assets/stage/app-icon.png';
import Icon from './Icon.astro';
import { t, otherLang, type Lang } from '../i18n';
import { downloadUrl } from '../data/release';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const other = otherLang(lang);
---

<div class="scroll-edge" data-scroll-edge></div>
<header class="topbar" data-topbar data-over-media>
  <nav class="glass glass--refract topbar-pill" aria-label="Perde">
    <a class="brand glass-btn" href={`/${lang}/`} aria-label="Perde">
      <Image src={appIcon} alt="" width={28} height={28} loading="eager" />
      <span>Perde</span>
    </a>
    <ul class="links">
      <li><a class="glass-btn" href="#tur">{d.nav.tour}</a></li>
      <li><a class="glass-btn" href="#ozellikler">{d.nav.features}</a></li>
      <li><a class="glass-btn" href="#karsilastir">{d.nav.compare}</a></li>
      <li><a class="glass-btn" href="#sss">{d.nav.faq}</a></li>
    </ul>
    <div class="tools">
      <a
        class="glass-btn lang"
        href={`/${other}/`}
        hreflang={other}
        lang={other}
        aria-label={d.nav.languageLabel}
        data-lang-switch={other}>{other.toUpperCase()}</a
      >
      <button
        class="glass-btn theme"
        type="button"
        data-theme-toggle
        data-label-light={d.nav.themeLight}
        data-label-dark={d.nav.themeDark}
        aria-label={d.nav.themeDark}
      >
        <Icon name="moon" size={18} />
        <Icon name="sun" size={18} />
      </button>
      <a class="btn-download topbar-download" href={downloadUrl('Perde-macOS-arm64.dmg')} data-download-link>
        <Icon name="download" size={18} />
        <span>{d.nav.download}</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .topbar {
    position: fixed;
    inset: max(12px, env(safe-area-inset-top)) 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 12px;
    pointer-events: none;
  }
  .topbar-pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    max-width: 100%;
    transition:
      background-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }
  .topbar[data-over-media] .topbar-pill {
    --glass-bg: rgb(20 20 22 / 0.3);
    --glass-rim: rgb(255 255 255 / 0.2);
    --glass-spec: rgb(255 255 255 / 0.3);
    --glass-shade: rgb(0 0 0 / 0.22);
    --glass-ink: #f5f5f7;
  }
  .brand {
    display: inline-flex;
    gap: 8px;
    padding-inline: 8px 14px;
    font-family: var(--font-brand);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: 0.02em;
  }
  .brand img {
    width: 28px;
    height: 28px;
    border-radius: 7px;
  }
  .links {
    display: flex;
    list-style: none;
    padding: 0;
    gap: 2px;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 6px;
  }
  .lang {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }
  .theme :global(.icon-sun),
  :global(:root[data-theme='dark']) .theme :global(.icon-moon) {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme :global(.icon-sun) {
    display: block;
  }
  .topbar-download {
    min-height: 44px;
    padding: 10px 18px;
    margin-left: 4px;
    font-size: 0.9375rem;
  }
  @media (max-width: 820px) {
    .links {
      display: none;
    }
  }
  @media (max-width: 400px) {
    .brand span {
      display: none;
    }
  }
</style>
