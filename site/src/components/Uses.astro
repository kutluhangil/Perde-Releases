---
// Kullanım biçimleri: dört sekme, her biri bir film sahnesi ve üç somut özellik.
import { Image } from 'astro:assets';
import { backdrops } from '../data/posters';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).uses;
const scene: Record<string, string> = {
  'film-gecesi': 'la-la-land',
  'dizi-maratonu': 'blade-runner-2049',
  arsivci: 'the-grand-budapest-hotel',
  'altyazi-titizi': 'parasite',
};
---

<section class="uses section" id="kullanim" aria-labelledby="uses-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="uses-title">{d.heading}</h2>
      <p>{d.sub}</p>
    </header>

    <div class="plate" data-uses>
      <div class="glass glass--refract tabs" role="tablist" aria-label={d.heading}>
        {
          d.items.map((u, i) => (
            <button
              class="glass-btn"
              type="button"
              role="tab"
              id={`use-tab-${u.id}`}
              aria-controls={`use-${u.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-pressed={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {u.name}
            </button>
          ))
        }
      </div>

      {
        d.items.map((u, i) => (
          <article class="panel" role="tabpanel" id={`use-${u.id}`} aria-labelledby={`use-tab-${u.id}`} hidden={i !== 0}>
            <div class="art">
              <Image src={backdrops[scene[u.id]]} alt="" widths={[640, 1200]} sizes="(min-width: 960px) 44vw, 100vw" loading="lazy" />
            </div>
            <div class="text">
              <h3>{u.line}</h3>
              <ul>
                {u.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .plate {
    display: grid;
    gap: 28px;
  }
  .tabs {
    justify-self: start;
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 6px;
    border-radius: 26px;
  }
  .tabs .glass-btn {
    padding-inline: 18px;
  }
  .panel {
    display: grid;
    gap: 32px 64px;
    align-items: center;
    animation: panel-in 0.6s var(--ease-out) both;
  }
  .panel[hidden] {
    display: none;
  }
  @media (min-width: 960px) {
    .panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .art {
    aspect-ratio: 4 / 3;
    border-radius: 28px;
    overflow: hidden;
    background: var(--stage);
  }
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: kenburns 12s var(--ease) both;
  }
  .text {
    display: grid;
    gap: 28px;
  }
  .text h3 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    letter-spacing: -0.025em;
  }
  .text ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .text li {
    padding: 12px 0;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--ink-2);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes kenburns {
    from {
      transform: scale(1.08);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-uses]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.setAttribute('aria-pressed', String(on));
        t.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (step) select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });
  });
</script>
