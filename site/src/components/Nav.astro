---
// Üst çubuk: solda ad, ortada Waterline sıvı menü (bulunulan bölümü izler), sağda GitHub, dil ve tema.
// Telefonda menü ekranın altına iner. Davranış: scripts/liquid-nav.ts ve scripts/shell.ts.
import Icon from './Icon.astro';
import { t, otherLang, type Lang } from '../i18n';
import { repo } from '../data/release';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const other = otherLang(lang);
const items = [
  { href: '#top', label: d.nav.home, icon: 'house', fx: 'glow' },
  { href: '#tur', label: d.nav.tour, icon: 'film', fx: 'spin' },
  { href: '#ozellikler', label: d.nav.features, icon: 'sparkle', fx: 'pop' },
  { href: '#karsilastir', label: d.nav.compare, icon: 'columns', fx: 'wave' },
  { href: '#indir', label: d.nav.download, icon: 'download', fx: 'drop' },
  { href: '#sss', label: d.nav.faq, icon: 'chat', fx: 'pop' },
] as const;
---

<header class="site-nav" data-site-nav>
  <a class="brand" href={`/${lang}/`} aria-label="Perde">Perde<span aria-hidden="true">®</span></a>

  <nav class="nimbus-nav" data-liquid-nav data-tone="light" data-gl="on" aria-label={d.nav.label}>
    <span class="nimbus-glass" aria-hidden="true"></span>
    <canvas class="nimbus-water" aria-hidden="true"></canvas>
    <span class="nimbus-drop" aria-hidden="true"></span>
    {
      items.map((it, i) => (
        <a class="nimbus-item" href={it.href} data-fx={it.fx} aria-current={i === 0 ? 'page' : undefined} aria-label={it.label} title={it.label}>
          <span class="nv-ico">
            {it.icon === 'house' ? (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3.5 11.2 12 4l8.5 7.2" />
                <path d="M6 9.6V20h12V9.6" />
                <path class="nv-door" d="M10 20v-5h4v5Z" />
              </svg>
            ) : (
              <Icon name={it.icon} size={18} />
            )}
          </span>
          <span class="nimbus-label">{it.label}</span>
        </a>
      ))
    }
  </nav>

  <div class="tools">
    <a class="tool glass" href={`https://github.com/${repo}`} aria-label={d.nav.github} title={d.nav.github}><Icon name="github" size={18} /></a>
    <a class="tool glass lang" href={`/${other}/`} hreflang={other} lang={other} aria-label={d.nav.languageLabel} data-lang-switch={other}
      >{other.toUpperCase()}</a
    >
    <button class="tool glass" type="button" data-theme-toggle data-label-light={d.nav.themeLight} data-label-dark={d.nav.themeDark} aria-label={d.nav.themeDark}>
      <Icon name="moon" size={18} />
      <Icon name="sun" size={18} />
    </button>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 18px max(var(--gutter), (100% - var(--max)) / 2) 0;
    pointer-events: none;
  }
  .site-nav > * {
    pointer-events: auto;
  }
  /* Kaydırma kenarı: içerik üst çubuğun altında bulanıklaşarak kaybolur */
  .site-nav::before {
    content: '';
    position: absolute;
    inset: 0 0 -28px;
    z-index: -1;
    background: linear-gradient(var(--bg) 30%, color-mix(in srgb, var(--bg) 0%, transparent));
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit-mask-image: linear-gradient(#000 55%, transparent);
    mask-image: linear-gradient(#000 55%, transparent);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    pointer-events: none;
  }
  .site-nav[data-scrolled]::before {
    opacity: 1;
  }
  .brand {
    justify-self: start;
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .brand span {
    font-size: 0.6em;
    vertical-align: super;
    margin-left: 1px;
    color: var(--ink-3);
  }
  .tools {
    justify-self: end;
    display: flex;
    gap: 8px;
  }
  .tool {
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: transform 0.25s var(--ease-out);
  }
  .tool:hover {
    transform: translateY(-1px);
  }
  :global(:root[data-theme='dark']) [data-theme-toggle] :global(.icon-moon),
  :global(:root[data-theme='light']) [data-theme-toggle] :global(.icon-sun) {
    display: none;
  }

  /* Telefon ve dar tablet: sıvı menü alt kenarda yüzer, üstte ad ve araçlar kalır */
  @media (max-width: 760px) {
    .site-nav {
      grid-template-columns: 1fr auto;
      padding-top: 14px;
    }
    /* left:50% + transform genişliği ekranın yarısına sıkıştırır; margin ile ortala */
    .nimbus-nav {
      position: fixed;
      left: 0;
      right: 0;
      bottom: calc(14px + env(safe-area-inset-bottom));
      width: max-content;
      margin-inline: auto;
    }
    .tool {
      width: 40px;
      height: 40px;
    }
  }
</style>
