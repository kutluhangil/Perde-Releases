---
// Hero: turdaki afişlerden bir yelpaze, binlerce parçacıktan yeniden kurulur; imleç onu sıvıya çevirir,
// bırakınca keskin görüntüye döner (scripts/hero.ts, scripts/liquid-engine.ts). WebGL2 yoksa durağan görsel kalır.
import Icon from './Icon.astro';
import { accent } from '../lib/accent';
import { downloadUrl, type Release } from '../data/release';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  release: Release;
}
const { lang, release } = Astro.props;
const d = t(lang);
const labels = JSON.stringify({ ...d.hero.download, soon: d.hero.soon });
---

<section class="sh-root" id="top" aria-labelledby="hero-title" data-hero data-download-labels={labels}>
  <div class="sh-backdrop" data-backdrop aria-hidden="true">perde</div>
  <div class="sh-stage" data-stage aria-hidden="true">
    <img class="sh-fallback" data-fallback src="/hero/fan-wide.webp" data-wide="/hero/fan-wide.webp" data-tall="/hero/fan-tall.webp" alt="" draggable="false" />
  </div>
  <p class="visually-hidden">{d.hero.alt}</p>

  <div class="sh-navspace" data-navspace aria-hidden="true"></div>
  <p class="sh-hint" data-hint data-touch={d.hero.hintTouch} aria-hidden="true">{d.hero.hint}</p>
  <div class="sh-spacer"></div>

  <div class="sh-content" data-content>
    <div>
      <p class="eyebrow">
        {d.hero.eyebrow.split(' · ')[0]} · <span lang="en">{d.hero.eyebrow.split(' · ')[1]}</span>
      </p>
      <h1 class="sh-h1" id="hero-title" set:html={accent(d.hero.headline, d.hero.accent)} />
    </div>
    <div class="sh-aside">
      <p class="sh-body">{d.hero.sub}</p>
      <div class="sh-ctas">
        <a class="btn" href={downloadUrl('Perde-macOS-arm64.dmg')} data-download-link data-download-label>
          <Icon name="download" size={18} />
          <span>{d.hero.download.macos}</span>
        </a>
        <a class="txt" href="#indir" data-other-systems>{d.hero.other}<Icon name="arrow-right" size={14} /></a>
      </div>
      <p class="sh-meta">v{release.version} · {d.hero.meta}</p>
    </div>
  </div>
</section>

<style>
  .sh-root {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 600px;
    max-height: 1080px;
    overflow: hidden;
    isolation: isolate;
    container-type: size;
    display: flex;
    flex-direction: column;
    touch-action: pan-y;
  }
  .sh-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .sh-stage :global(.sh-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .sh-fallback {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(102%, 1500px);
    max-width: none;
    transform: translate(-50%, -50%);
    user-select: none;
    -webkit-user-drag: none;
    transition: opacity 0.5s ease;
  }
  .sh-fallback[data-placed] {
    transform: none;
  }
  .sh-root[data-gl='on'] .sh-stage :global(.sh-canvas) {
    opacity: 1;
  }
  .sh-root[data-gl='on'] .sh-fallback,
  .sh-root[data-swap='1'] .sh-fallback,
  .sh-root[data-swap='1'] .sh-stage :global(.sh-canvas) {
    opacity: 0;
    transition-duration: 0.25s;
  }
  .sh-backdrop {
    position: absolute;
    left: 50%;
    top: 46%;
    z-index: 0;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    font-weight: 600;
    font-size: 30cqw;
    letter-spacing: -0.06em;
    line-height: 0.8;
    color: color-mix(in srgb, var(--ink) 5%, transparent);
  }
  .sh-navspace {
    flex: none;
    height: 84px;
  }
  .sh-hint {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 70%;
    transform: translate(-50%, 0);
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    opacity: 0.6;
    pointer-events: none;
    transition: opacity 0.8s ease;
  }
  .sh-hint::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: sh-pulse 2.4s ease-in-out infinite;
  }
  .sh-root[data-touched='1'] .sh-hint {
    opacity: 0;
  }
  @keyframes sh-pulse {
    0%,
    100% {
      transform: scale(0.6);
      opacity: 0.45;
    }
    50% {
      transform: scale(1);
      opacity: 1;
    }
  }
  .sh-spacer {
    flex: 1 1 auto;
    min-height: 0;
  }
  .sh-content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(24px, 4cqw, 72px);
    padding: 0 var(--gutter) clamp(28px, 3.4cqw, 52px);
  }
  .sh-h1 {
    font-weight: 500;
    font-size: clamp(40px, min(6.6cqw, 11.5cqh), 124px);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .sh-h1 :global(.line) {
    display: block;
  }
  .sh-aside {
    max-width: 400px;
    justify-self: end;
    padding-bottom: 0.6em;
  }
  .sh-body {
    font-size: clamp(15px, 1.1cqw, 17px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    margin: 0 0 26px;
    color: var(--ink-2);
  }
  .sh-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
  }
  .sh-meta {
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  @container (max-width: 1023px) {
    .sh-content {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .sh-aside {
      justify-self: start;
      max-width: 520px;
      padding-bottom: 0;
    }
    .sh-h1 {
      font-size: clamp(40px, min(9.5cqw, 9cqh), 96px);
    }
  }
  @container (max-width: 639px) {
    .sh-navspace {
      height: 64px;
    }
    .sh-h1 {
      font-size: clamp(36px, min(12.5cqw, 7.2cqh), 60px);
      line-height: 0.94;
    }
    .sh-body {
      font-size: 15px;
      margin-bottom: 20px;
    }
    .sh-content {
      padding-bottom: 104px;
    }
    .sh-content .eyebrow,
    .sh-meta {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sh-hint::before {
      animation: none;
    }
  }
</style>

<script>
  import '../scripts/hero';
</script>
