---
// Özellikler: üç sütun, her satır ad ve tek cümle. Altta iki kısa not: gizlilik ve sıradaki sürüm.
import { accent } from '../lib/accent';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).features;
---

<section class="features section" id="ozellikler" aria-labelledby="features-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{d.eyebrow}</p>
        <h2 id="features-title" set:html={accent(d.heading, d.accent)} />
      </div>
      <p>{d.sub}</p>
    </header>

    <div class="cols">
      {
        d.groups.map((g, gi) => (
          <div class="col" data-reveal style={`transition-delay:${gi * 80}ms`}>
            <h3>
              <span class="num">0{gi + 1}</span>
              {g.name}
            </h3>
            <ul>
              {g.items.map(([name, text]) => (
                <li>
                  <strong>{name}</strong>
                  <span>{text}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="notes">
      <div class="note" data-reveal>
        <h3>{d.privacy.heading}</h3>
        <p>{d.privacy.text}</p>
      </div>
      <div class="note next" data-reveal>
        <h3><span class="dot" aria-hidden="true"></span>{d.next.heading}</h3>
        <ul>
          {
            d.next.items.map(([name, text]) => (
              <li>
                <strong>{name}</strong>
                <span>{text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
  .col h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-bottom: 14px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--line-2);
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }
  .num {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  .col li {
    display: grid;
    gap: 2px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  li strong {
    font-weight: 500;
    font-size: 0.9875rem;
    letter-spacing: -0.012em;
  }
  li span {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(40px, 5vw, 64px);
  }
  @media (max-width: 860px) {
    .notes {
      grid-template-columns: 1fr;
    }
  }
  .note {
    padding: clamp(22px, 2.6vw, 32px);
    border-radius: var(--radius);
    background: var(--bg-3);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .note h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }
  .note > p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .next ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 28px;
  }
  @media (max-width: 560px) {
    .next ul {
      grid-template-columns: 1fr;
    }
  }
  .next li {
    display: grid;
    gap: 2px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 4px var(--amber-soft);
  }
</style>
