---
// Özellikler: üç sütun, aynı boyda adlar; açıklama üzerine gelince (dokunmatikte her zaman) görünür.
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).features;
---

<section class="features section" id="ozellikler" aria-labelledby="features-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="features-title">{d.heading}</h2>
      <p>{d.sub}</p>
    </header>
    <div class="cols">
      {
        d.groups.map((g) => (
          <div class="col">
            <h3>{g.name}</h3>
            <ul>
              {g.items.map(([name, text]) => (
                <li tabindex="0">
                  <span class="name">{name}</span>
                  <span class="text">{text}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: 56px 48px;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink-3);
    margin-bottom: 18px;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    display: grid;
    padding: 10px 0;
    outline-offset: 6px;
  }
  .name {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    transition: color 0.3s var(--ease);
  }
  .text {
    display: grid;
    font-size: 1rem;
    color: var(--ink-2);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.45s var(--ease-out),
      opacity 0.35s var(--ease),
      margin 0.45s var(--ease-out);
  }
  li:hover .text,
  li:focus-visible .text {
    max-height: 4.5em;
    opacity: 1;
    margin-top: 6px;
  }
  ul:has(li:hover) li:not(:hover) .name {
    color: var(--ink-3);
  }
  @media (hover: none) {
    .text {
      max-height: none;
      opacity: 1;
      margin-top: 4px;
    }
    ul:has(li:hover) li:not(:hover) .name {
      color: inherit;
    }
  }
</style>
