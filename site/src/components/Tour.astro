---
// Canlı tur: uygulamanın penceresi (public/tour/, iframe) + bölüm çubuğu + sistem seçici. Yönetim scripts/tour.ts'de.
import Icon from './Icon.astro';
import { createHash } from 'node:crypto';
import { accent } from '../lib/accent';
import { t, type Lang } from '../i18n';
import { films } from '../data/films';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const version = createHash('sha1').update(JSON.stringify(films)).digest('hex').slice(0, 8);
const icons = ['sparkle', 'house', 'grid', 'film', 'play', 'captions', 'folder', 'wand', 'gear', 'chat'] as const;
const durations = [5200, 7600, 6400, 7000, 7600, 7600, 7400, 7000, 7200, 7000];
const systems = [
  ['macos', 'macOS'],
  ['windows', 'Windows'],
  ['linux', 'Linux'],
] as const;
---

<section class="tour section" id="tur" aria-labelledby="tour-title" data-tour>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{d.tour.eyebrow}</p>
        <h2 id="tour-title" set:html={accent(d.tour.heading, d.tour.accent)} />
      </div>
      <p>{d.tour.sub}</p>
    </header>
  </div>

  <div class="stage wrap">
    <div class="frame" data-frame data-os="macos">
      <iframe
        title={`Perde · ${d.tour.heading}`}
        data-src={`/tour/?lang=${lang}&v=${version}`}
        loading="lazy"
        tabindex="0"></iframe>
      <noscript><p class="nojs">{d.tour.sub}</p></noscript>
    </div>

    <div class="controls">
      <div class="glass glass--refract chapterbar">
        <button class="glass-btn round" type="button" data-prev aria-label={d.tour.prev}
          ><Icon name="chevron-left" size={18} /></button
        >
        <button class="glass-btn round" type="button" data-toggle aria-label={d.tour.pause} data-label-play={d.tour.play} data-label-pause={d.tour.pause}>
          <Icon name="pause" size={18} />
          <Icon name="play" size={18} />
        </button>
        <div class="now" aria-live="polite">
          <p class="name">
            <span data-chapter-name>{d.tour.chapters[0].name}</span>
            <span class="count"><span data-chapter-index>1</span> {d.tour.of} {d.tour.chapters.length}</span>
          </p>
          <p class="line" data-chapter-line>{d.tour.chapters[0].line}</p>
          <span class="progress" aria-hidden="true"><i data-progress></i></span>
        </div>
        <button class="glass-btn round" type="button" data-next aria-label={d.tour.next}
          ><Icon name="chevron-right" size={18} /></button
        >
      </div>

      <div class="glass glass--refract os" role="radiogroup" aria-label={d.tour.os}>
        {
          systems.map(([id, label], i) => (
            <button class="glass-btn" type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} aria-pressed={i === 0 ? 'true' : 'false'} data-os={id}>
              {label}
            </button>
          ))
        }
      </div>
    </div>

    <ol class="dock glass glass--refract" aria-label={d.tour.heading}>
      {
        d.tour.chapters.map((c, i) => (
          <li>
            <button
              class="glass-btn"
              type="button"
              data-chapter={c.id}
              data-index={i}
              data-name={c.name}
              data-line={c.line}
              data-duration={durations[i]}
              aria-current={i === 0 ? 'true' : undefined}
              aria-label={`${i + 1}. ${c.name}`}
              title={c.name}
            >
              <Icon name={icons[i]} size={20} />
            </button>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .tour {
    position: relative;
    overflow: clip;
  }
  .stage {
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .frame {
    --k: 1;
    --r: 16px;
    position: relative;
    width: 100%;
    max-width: 1200px;
    aspect-ratio: 1200 / 750;
    border-radius: calc(var(--r) * var(--k));
    background: var(--stage);
    box-shadow:
      0 0 0 0.5px rgb(255 255 255 / 0.16),
      0 40px 100px -40px rgb(0 0 0 / 0.6),
      0 0 120px -40px color-mix(in srgb, var(--tint) 40%, transparent);
    transition:
      border-radius 0.4s var(--ease),
      box-shadow 1.4s var(--ease);
  }
  :global(:root[data-theme='light']) .frame {
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.18),
      0 50px 110px -40px rgb(0 0 0 / 0.45),
      0 0 140px -40px color-mix(in srgb, var(--tint) 40%, transparent);
  }
  .frame[data-os='windows'] {
    --r: 8px;
  }
  .frame[data-os='linux'] {
    --r: 12px;
  }
  .frame iframe {
    position: absolute;
    left: 0;
    top: 0;
    width: 1200px;
    height: 750px;
    border: 0;
    border-radius: var(--r);
    transform: scale(var(--k));
    transform-origin: 0 0;
    background: transparent;
    color-scheme: dark;
  }
  .nojs {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 32px;
    color: var(--stage-ink-2);
    text-align: center;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    width: 100%;
  }
  .chapterbar {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    width: min(100%, 640px);
    border-radius: 28px;
  }
  .round {
    padding-inline: 0;
    width: 44px;
    flex: none;
  }
  [data-toggle] :global(.icon-play),
  [data-toggle][data-paused] :global(.icon-pause) {
    display: none;
  }
  [data-toggle][data-paused] :global(.icon-play) {
    display: block;
  }
  .now {
    position: relative;
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 2px;
    padding: 6px 12px 10px;
  }
  .name {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
  }
  .count {
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .line {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .progress {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
    overflow: hidden;
  }
  .progress i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--ink);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .os {
    display: flex;
    gap: 2px;
    padding: 6px;
  }
  .os .glass-btn {
    padding-inline: 16px;
  }
  .dock {
    display: flex;
    gap: 4px;
    padding: 6px;
    list-style: none;
    border-radius: 24px;
    max-width: 100%;
  }
  @media (max-width: 600px) {
    .dock {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
  .dock .glass-btn {
    width: 48px;
    height: 48px;
    padding: 0;
    border-radius: 16px;
    color: var(--ink-2);
  }
  .dock .glass-btn[aria-current='true'] {
    color: var(--ink);
  }

  /* Telefon: pencere ölçeklenmez; uygulamanın kendi dar düzeni açılır */
  @media (max-width: 719px) {
    .frame {
      aspect-ratio: auto;
      height: min(640px, 78svh);
    }
    .frame iframe {
      width: 100%;
      height: 100%;
      transform: none;
    }
    .line {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  import '../scripts/tour';
</script>
