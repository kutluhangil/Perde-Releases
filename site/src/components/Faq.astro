---
// SSS: geniş başlık, girintili sorular; <details> ile JS'siz çalışır.
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).faq;
---

<section class="faq section" id="sss" aria-labelledby="faq-title">
  <div class="wrap grid">
    <h2 id="faq-title">{d.heading}</h2>
    <div class="list">
      {
        d.items.map(([q, a]) => (
          <details>
            <summary>
              <span>{q}</span>
              <span class="glass toggle" aria-hidden="true">
                <Icon name="chevron-down" size={18} />
              </span>
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 32px 64px;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    }
  }
  h2 {
    font-size: var(--step-3);
  }
  details {
    padding: 4px 0;
  }
  details + details {
    margin-top: 4px;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 0;
    list-style: none;
    cursor: pointer;
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    transition: transform 0.4s var(--ease-out);
  }
  details[open] .toggle {
    transform: rotate(180deg);
  }
  details p {
    color: var(--ink-2);
    max-width: 60ch;
    padding-bottom: 18px;
    font-size: 1.0625rem;
  }
  @supports (interpolate-size: allow-keywords) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.45s var(--ease-out),
        content-visibility 0.45s allow-discrete;
    }
    details[open]::details-content {
      height: auto;
    }
  }
</style>
