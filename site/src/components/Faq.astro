---
// SSS: solda yapışkan başlık sütunu, sağda sorular. Sütunlar arasında sabit boşluk; <details> ile JS'siz çalışır.
import Icon from './Icon.astro';
import { accent } from '../lib/accent';
import { issuesPage } from '../data/release';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).faq;
---

<section class="faq section" id="sss" aria-labelledby="faq-title">
  <div class="wrap grid">
    <header class="head" data-reveal>
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 id="faq-title" set:html={accent(d.heading, d.accent)} />
      <p class="sub">{d.sub}</p>
      <a class="txt" href={issuesPage}>{d.ask}<Icon name="arrow-up-right" size={14} /></a>
    </header>
    <div class="list" data-reveal>
      {
        d.items.map(([q, a]) => (
          <details>
            <summary>
              <span>{q}</span>
              <span class="toggle" aria-hidden="true">
                <Icon name="chevron-down" size={16} />
              </span>
            </summary>
            <p>{a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.4fr);
      gap: clamp(48px, 7vw, 112px);
      align-items: start;
    }
    .head {
      position: sticky;
      top: 104px;
    }
  }
  .head h2 {
    font-size: var(--h2);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .head :global(.accent) {
    display: inline-block;
  }
  .sub {
    max-width: 30ch;
    margin: 20px 0 18px;
    color: var(--ink-2);
  }
  .list {
    border-top: 1px solid var(--line-2);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    font-weight: 500;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    letter-spacing: -0.015em;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--ink-2);
    transition:
      transform 0.35s var(--ease-out),
      background-color 0.2s,
      color 0.2s;
  }
  summary:hover .toggle {
    background: var(--ink);
    color: var(--bg);
  }
  details[open] .toggle {
    transform: rotate(180deg);
  }
  details p {
    max-width: 62ch;
    padding: 0 48px 22px 0;
    color: var(--ink-2);
    line-height: 1.6;
  }
</style>
