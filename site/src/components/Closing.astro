---
// Kapanış ve footer: perde yeniden kapanır, ad tam genişlikte döner.
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
import { downloadUrl, issuesPage, releasesPage } from '../data/release';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const letters = ['P', 'E', 'R', 'D', 'E'];
---

<section class="closing" aria-labelledby="cta-title">
  <div class="wrap inner">
    <h2 id="cta-title">{d.cta.heading}</h2>
    <p>{d.cta.sub}</p>
    <div class="actions">
      <a class="btn-download" href={downloadUrl('Perde-macOS-arm64.dmg')} data-download-link data-download-label>
        <Icon name="download" />
        <span>{d.hero.download.macos}</span>
      </a>
      <a class="glass glass--clear glass-btn other" href="#indir">{d.hero.other}</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap">
    <nav class="links" aria-label="Perde">
      <a href="#indir">{d.footer.links.download}</a>
      <a href={releasesPage}>{d.footer.links.releases}</a>
      <a href={issuesPage}>{d.footer.links.issues}</a>
      <a href="https://github.com/kutluhangil">{d.footer.made}</a>
    </nav>
    <div class="notes">
      <p>{d.footer.fictional}</p>
      <p>{d.footer.tmdb}</p>
      <p>© 2026 Kutluhan Gül · {d.footer.rights}</p>
    </div>
  </div>
  <p class="word" aria-hidden="true">{letters.map((l, i) => <span style={`--i:${i}`}>{l}</span>)}</p>
</footer>

<style>
  .closing {
    background: var(--stage);
    color: var(--stage-ink);
    padding-block: clamp(120px, 16vw, 220px) clamp(80px, 10vw, 140px);
    text-align: center;
  }
  .inner {
    display: grid;
    justify-items: center;
    gap: 22px;
  }
  .closing h2 {
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: clamp(3.5rem, 2rem + 7vw, 9rem);
    letter-spacing: -0.01em;
    line-height: 0.95;
  }
  .closing p {
    font-size: var(--step-1);
    color: var(--stage-ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
  }
  .other {
    min-height: 52px;
    padding-inline: 22px;
    font-size: 1rem;
  }
  .footer {
    background: var(--stage);
    color: var(--stage-ink);
    padding-top: 56px;
    overflow: hidden;
  }
  .footer .wrap {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 900px) {
    .footer .wrap {
      grid-template-columns: auto 1fr;
      gap: 64px;
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    font-weight: 600;
  }
  .links a {
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .notes {
    display: grid;
    gap: 6px;
    font-size: 0.875rem;
    color: var(--stage-ink-2);
  }
  @media (min-width: 900px) {
    .notes {
      justify-items: end;
      text-align: right;
    }
  }
  .word {
    display: flex;
    justify-content: center;
    margin-top: 40px;
    font-family: var(--font-brand);
    font-weight: 500;
    font-size: calc((100vw - 2 * var(--gutter)) / 3.6);
    line-height: 0.72;
    margin-bottom: -0.12em;
    color: #f5f5f7;
  }
  .word span {
    display: block;
  }
</style>
